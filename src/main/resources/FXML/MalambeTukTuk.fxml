            <Font size="17.0" />
         </font>
      </Label>
      <Separator layoutY="43.0" prefHeight="3.0" prefWidth="819.0" />
      <Hyperlink layoutX="753.0" layoutY="14.0" onAction="#onHelpClick" text="Help">
         <font>
            <Font size="13.0" />
         </font>
      </Hyperlink>
      <Label fx:id="help" layoutX="343.0" layoutY="62.0" />
