      </Button>
      <TextField layoutX="566.0" layoutY="49.0" prefHeight="32.0" prefWidth="160.0" promptText="Search Items" />
      <Button layoutX="735.0" layoutY="49.0" mnemonicParsing="false" prefHeight="32.0" prefWidth="72.0" text="Filter">
