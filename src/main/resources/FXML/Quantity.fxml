<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="260.0" prefWidth="380.0" stylesheets="@../CSS/MainStyleSheet.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.AddToCartController">
    <children>
        <VBox layoutX="0.0" layoutY="0.0" spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="24.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <Label text="Add to Cart">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>

                <Label fx:id="productNameLabel" style="-fx-text-fill: #7A7A7A; -fx-font-size: 14px;" text="Product" />

                <Label styleClass="stat-box-title" text="Quantity" />
                <Spinner fx:id="quantitySpinner" editable="true" prefWidth="120.0" />

                <HBox alignment="CENTER">
                    <children>
                        <Button fx:id="okButton" mnemonicParsing="false" onAction="#onOkClick" prefWidth="140.0" styleClass="filled-button" text="OK" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>