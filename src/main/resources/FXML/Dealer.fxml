<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.DealerController">
   <children>
      <Label layoutX="40.0" layoutY="24.0" text="DEALERS">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="66.0" style="-fx-text-fill: #7A7A7A; -fx-font-size: 14px;" text="Manage your dealers here" />
      <HBox layoutX="40.0" layoutY="100.0" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onRandomSelectClick" styleClass="nav-button" text="Random Select" />
            <Button mnemonicParsing="false" onAction="#onResetClick" styleClass="nav-button" text="Reset" />
         </children>
      </HBox>
      <TableView fx:id="dealerTable" layoutX="40.0" layoutY="150.0" prefHeight="540.0" prefWidth="980.0">
         <columns>
            <TableColumn fx:id="codeColumn" prefWidth="200.0" text="Code" />
            <TableColumn fx:id="nameColumn" prefWidth="300.0" text="Name" />
            <TableColumn fx:id="contactColumn" prefWidth="230.0" text="Contact" />
            <TableColumn fx:id="locationColumn" prefWidth="250.0" text="Location" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
