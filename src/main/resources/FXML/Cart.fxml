<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1060.0" stylesheets="@../CSS/MainStyleSheet.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CartController">
   <children>
      <Label layoutX="40.0" layoutY="24.0" text="CART">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="66.0" style="-fx-text-fill: #7A7A7A; -fx-font-size: 14px;" text="Manage your cart here" />

      <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="92.0" prefWidth="980.0" spacing="12.0">
         <children>
            <Button fx:id="adjustQuantityBtn" mnemonicParsing="false" onAction="#onAdjustQuantityButtonClick" styleClass="secondary-button" text="Adjust Quantity" />
            <Button fx:id="removeBtn" mnemonicParsing="false" onAction="#onRemoveButtonClick" styleClass="filled-button" text="Remove" />
         </children>
      </HBox>

      <TableView fx:id="cartTable" layoutX="40.0" layoutY="140.0" prefHeight="380.0" prefWidth="980.0">
         <columns>
            <TableColumn fx:id="codeColumn" prefWidth="75.0" text="Code" />
            <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="brandColumn" prefWidth="75.0" text="Brand" />
            <TableColumn fx:id="priceColumn" prefWidth="75.0" text="Price" />
            <TableColumn fx:id="quantityColumn" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER" layoutX="40.0" layoutY="540.0" prefWidth="980.0" spacing="20.0">
         <children>
            <VBox prefHeight="140.0" prefWidth="650.0" styleClass="stat-box">
               <children>
                  <Label styleClass="stat-box-title" text="Order Summary" />
                  <Label fx:id="totalLabel" styleClass="cart-total-text" text="No Discounts Applied&#10;Total: 0.00" wrapText="true" />
               </children>
            </VBox>
            <Button fx:id="proceedBtn" mnemonicParsing="false" onAction="#onProceedButtonClick" prefHeight="60.0" prefWidth="280.0" styleClass="filled-button" text="Proceed" />
         </children>
      </HBox>
   </children>
</AnchorPane>
