<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1060.0" stylesheets="@../CSS/MainStyleSheet.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.InventoryController">
   <children>
      <Label layoutX="40.0" layoutY="24.0" text="INVENTORY">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="66.0" style="-fx-text-fill: #7A7A7A; -fx-font-size: 14px;" text="Manager your inventory here" />

      <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="86.0" prefWidth="980.0" spacing="12.0">
         <children>
            <TextField fx:id="searchField" prefWidth="250.0" promptText="Enter keyword" />
            <Button mnemonicParsing="false" styleClass="filled-button" text="Search" />
            <Button fx:id="filterBtn" mnemonicParsing="false" styleClass="secondary-button" text="Filter" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onAddButtonClick" styleClass="filled-button" text="Add Product" />
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="134.0" prefWidth="980.0" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onUpdateButtonClick" styleClass="filled-button" text="Update" />
            <Button mnemonicParsing="false" onAction="#onDeleteButtonClick" styleClass="filled-button" text="Delete" />
            <Button fx:id="thresholdBtn" mnemonicParsing="false" onAction="#onThresholdButtonClick" styleClass="secondary-button" text="Threshold" />
            <Button fx:id="showPictureBtn" managed="false" mnemonicParsing="false" styleClass="secondary-button" text="Show Picture" visible="false" />
            <Region prefHeight="40.0" prefWidth="551.0" />
            <Button fx:id="cartBtn" mnemonicParsing="false" styleClass="secondary-button" text="Add To Cart" />
         </children>
      </HBox>

      <TableView fx:id="productsTable" layoutX="40.0" layoutY="180.0" prefHeight="510.0" prefWidth="980.0">
        <columns>
          <TableColumn fx:id="codeColumn" prefWidth="75.0" text="Code" />
          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="brandColumn" prefWidth="75.0" text="Brand" />
            <TableColumn fx:id="priceColumn" prefWidth="75.0" text="Price" />
            <TableColumn fx:id="quantityColumn" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
            <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
            <TableColumn fx:id="stockColumn" prefWidth="75.0" text="Stock" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</AnchorPane>
